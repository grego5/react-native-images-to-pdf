{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["imagespdf"],
  "ios": {
    "iosModuleName": "NitroImagesToPdf"
  },
  "android": {
    "androidNamespace": ["imagespdf"],
    "androidCxxLibName": "NitroImagesToPdf"
  },
  "autolinking": {
    "ImagesToPdf": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridImagesToPdf"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridImagesToPdf"
      }
    }
  },
  "ignorePaths": ["**/node_modules/**"],
  "gitAttributesGeneratedFlag": true
}
